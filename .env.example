# Copy this file to ".env" and fill in your CrowdStrike API credentials.
# Create an API client at: Falcon console -> Support and resources ->
# API clients and keys -> Create API client.
#
# Required API scope for running NG-SIEM CQL searches:
#   NGSIEM search        Read & Write
# (If querying legacy Falcon LogScale directly you may also grant:
#   Falcon LogScale / Humio  Read & Write)

FALCON_CLIENT_ID=your_client_id_here
FALCON_CLIENT_SECRET=your_client_secret_here

# Optional overrides (otherwise config.yaml / defaults are used):
# FALCON_REGION=us-1
# FALCON_REPOSITORY=search-all
